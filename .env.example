# Copy to .env.local for local dev; add the same variables in Vercel → Project → Settings → Environment Variables.

# Supabase project (Project Settings → API)
SUPABASE_URL=https://tlkatzpkwczzzkfnopsz.supabase.co
# Server-only secret key (sb_secret_… or the legacy service_role key). Never expose it in the browser.
SUPABASE_SECRET_KEY=
# Publishable key — only used by `npm run check` to confirm the project is reachable.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_QCxCJoDrl5vJICXVcABfdA_ejKF9q4N
# Storage bucket for PDFs (created by supabase/schema.sql)
SUPABASE_BUCKET=resumes

# Login for the web app
APP_USERNAME=jkr
APP_PASSWORD=jkr
# Any long random string; signs the login cookie
SESSION_SECRET=

# Local dev only: path to Chrome/Edge for PDF rendering (auto-detected on Windows if empty)
CHROME_PATH=
