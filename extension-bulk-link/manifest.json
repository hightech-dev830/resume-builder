{
  "manifest_version": 3,
  "name": "Auto Bid for Bulk Links",
  "version": "1.0.0",
  "description": "Applies to remote jobs from bulk links with an AI-tailored resume and cover letter, and saves every bid to Resume Builder.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Auto Bid",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": []
}
